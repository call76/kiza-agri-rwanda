KIZA_SECRET=change-me-long-random
KIZA_COOKIE_SECURE=1
KIZA_DEMO_PASSWORD=Kiza@2026-demo
KIZA_SMTP_HOST=
KIZA_SMTP_PORT=587
KIZA_SMTP_USER=
KIZA_SMTP_PASS=
KIZA_MAIL_FROM=no-reply@kiza-agri.rw
KIZA_EMAIL_STORE_BODY=0
KIZA_SMS_PROVIDER=mock        # or http (needs KIZA_SMS_URL, KIZA_SMS_KEY)
KIZA_SMS_DLR_SECRET=
KIZA_CAPTCHA_VERIFY_URL=      # e.g. Cloudflare Turnstile siteverify URL
KIZA_CAPTCHA_SECRET=
KIZA_JOBS=1                   # in-process scheduler (alerts, SMS dispatch, price sync) every 15 min
KIZA_ALERT_SIMULATED=0

# --- v10 assistant ---
ANTHROPIC_API_KEY=            # REQUIRED for the real AI assistant (Claude + live web search). Without it the assistant still answers from sourced facts + platform data.
KIZA_AI_MODEL=claude-haiku-5-5  # fast + cheap; use claude-sonnet-5-5 for deeper answers
KIZA_AI_WEB=1                 # 1 = Claude may search the internet (max 2 searches per question); 0 = off
KIZA_AI_DAILY=80              # AI questions per user per day (cost guard)
KIZA_DEMO=0                   # 1 = create the old DEMO database when kiza.db is missing

# data.gov.rw Data Sharing Platform (kiza8/datagov.py). Put the real key in .env, not here.
KIZA_DATAGOV_KEY=dsp_pub_xxxxxxxx
# KIZA_DATAGOV_BASE=https://data.gov.rw/api/v1   # confirm from the API-access page
